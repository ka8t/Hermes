<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional: runs llama-server in the background (starts at login, restarts
  if it crashes), so you don't need to keep a terminal open at all times.

  Install:
    cp scripts/com.hermes.llama-server.plist.example \
       ~/Library/LaunchAgents/com.hermes.llama-server.plist
    # edit the two paths below (REPLACE_WITH_REPO_PATH)
    launchctl load ~/Library/LaunchAgents/com.hermes.llama-server.plist

  To stop it:
    launchctl unload ~/Library/LaunchAgents/com.hermes.llama-server.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hermes.llama-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_REPO_PATH/macos-arm64/scripts/run-llama-server.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_REPO_PATH/macos-arm64</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>REPLACE_WITH_REPO_PATH/macos-arm64/llama-server.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_REPO_PATH/macos-arm64/llama-server.log</string>
</dict>
</plist>
