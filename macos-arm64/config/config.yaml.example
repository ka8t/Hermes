# Copy this to ./data/config.yaml BEFORE the first `docker compose up`
# (./data is the volume mounted at /opt/data in the hermes container — see README.md)
#
# llama-swap (and the llama-server it spawns) run NATIVELY on the Mac (not in
# Docker, to keep Metal acceleration): the hermes container therefore reaches
# it via host.docker.internal, automatically resolved by Docker Desktop for
# Mac to the host machine — no IP address to know. "llama-3.1-8b-instruct" must
# match a key under models: in data/models.yaml exactly (see
# ../../shared/managing-models.md).

model:
  default: llama-3.1-8b-instruct
  provider: custom
  base_url: http://host.docker.internal:8080/v1
  context_length: 65536

# Every dangerous action requires an explicit human answer — no silent
# auto-approval, on any deployment size. See ../../shared/enterprise-safety.md
# for exactly what this does and does not cover.
approvals:
  mode: manual
