# Copy this to ./data/config.yaml BEFORE the first `docker compose up`
# (./data is the volume mounted at /opt/data in the hermes container — see README.md)
#
# llama-swap (and the llama-server it spawns) run NATIVELY on the Mac (not in
# Docker, to keep Metal acceleration): the hermes container therefore reaches
# it via host.docker.internal, automatically resolved by Docker Desktop for
# Mac to the host machine — no IP address to know. "llama-3.1-8b-instruct" must
# match a key under models: in data/models.yaml exactly (see
# ../../shared/managing-models.md).

model:
  default: llama-3.1-8b-instruct
  provider: custom
  base_url: http://host.docker.internal:8080/v1
  context_length: 65536

# Docker Desktop for Mac shares ./data into the container over virtiofs,
# which SQLite's WAL (write-ahead log) mode is not reliably crash-safe
# on — confirmed live, 2026-09-03: the gateway refused to start with
# "a live process holds a deleted state.db-wal or state.db-shm inode...
# Refusing to open or write so a second WAL cannot be minted", on a
# freshly emptied ./data, not just a leftover-file issue. This is the
# base Hermes image's own documented mitigation for exactly this
# bind-mount class (its own cli-config.yaml.example lists "Linux
# containers bind-mounted through macOS virtiofs" explicitly).
# Hermes will not live-downgrade a database already opened in WAL mode —
# this must be set before the very first `docker compose up` (or with
# ./data emptied first) to take effect.
database:
  journal_mode: delete

# run_budget_seconds is defense-in-depth against agentic goal-drift (a real
# incident, see ../../shared/model-notes.md and issue #37): at 80% elapsed
# Hermes injects a one-time "wrap up" notice telling the model to stop new
# work and deliver a final answer instead of continuing to drift. This is a
# mitigation, not the fix — the actual fix is model verification, see
# issues #28-#32. Full Metal offload makes a 1h runaway far less likely here
# than on the CPU-only VPS path, but the same bound applies regardless of
# how fast inference is, since the risk is drift, not slowness.
agent:
  run_budget_seconds: 3600

# Every dangerous action requires an explicit human answer — no silent
# auto-approval, on any deployment size. See ../../shared/enterprise-safety.md
# for exactly what this does and does not cover.
approvals:
  mode: manual

# Hermes's default auxiliary-model routing tries free-tier external
# providers (OpenRouter, Nous Portal) before falling back to the main
# model for session-title generation — an outbound call this deployment
# doesn't configure credentials for, and one that contradicts "nothing
# leaves the server". Manual titles still work via /title.
auxiliary:
  title_generation:
    enabled: false
