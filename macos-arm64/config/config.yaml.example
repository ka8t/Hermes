# Copy this to ./data/config.yaml BEFORE the first `docker compose up`
# (./data is the volume mounted at /opt/data in the hermes container — see README.md)
#
# llama-server runs NATIVELY on the Mac (not in Docker, to keep Metal
# acceleration): the hermes container therefore reaches it via
# host.docker.internal, automatically resolved by Docker Desktop for Mac to
# the host machine — no IP address to know.

model:
  default: qwen2.5-coder-7b-instruct
  provider: custom
  base_url: http://host.docker.internal:8080/v1
  context_length: 65536
