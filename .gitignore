# Secrets
.env
*.env
!*.env.example

# GGUF models (too large for git — downloaded by the scripts)
*.gguf
linux-x86_64-vps/models/*
!linux-x86_64-vps/models/.gitkeep
macos-arm64/models/*
!macos-arm64/models/.gitkeep

# Persistent Hermes state (memory, sessions, skills, real config.yaml)
**/.hermes/
**/data/
**/data.bak.*/

# Downloaded/built llama.cpp binaries (prebuilt archives or from-source builds)
macos-arm64/vendor/
linux-x86_64-vps/vendor/

# BFCL evaluation workspace (generated results, downloaded tokenizer
# files, .env) — the venv itself never touches the host at all, see
# eval/Dockerfile and #51.
eval/bfcl-workspace/

# macOS
.DS_Store
macos-arm64/llama-swap.log

# Editors
.vscode/
.idea/
