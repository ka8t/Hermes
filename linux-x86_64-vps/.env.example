# --- Telegram (see ../shared/telegram-setup.md) ---
TELEGRAM_BOT_TOKEN=changeme:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ALLOWED_USERS=000000000
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=

# --- Model(s) served via llama-swap + llama.cpp (see ../shared/managing-models.md) ---
MODEL_FILE=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
MODEL_REPO=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF
LLAMA_CTX_SIZE=65536
# CPU cores to allocate to inference (adjust to the rented VPS, e.g. KVM2 = 2)
LLAMA_THREADS=2
# GPU layers to offload — only read when using docker-compose.gpu.yml (see
# ../shared/gpu-setup.md, issue #13). 99 = offload every layer (full GPU),
# same convention as macos-arm64's Metal path. Ignored on the CPU image.
LLAMA_GPU_LAYERS=99

# --- Public HTTPS exposure (WhatsApp Cloud API / Microsoft Teams only —
#     Telegram needs none of this). See ../shared/cloudflare-tunnel-setup.md.
#     The cloudflared container only starts if BOTH of these are set —
#     COMPOSE_PROFILES activates its Compose profile; leaving it unset
#     keeps cloudflared off entirely instead of crash-looping on an empty
#     token (found live, 2026-09-06).
CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=cloudflare

# --- WhatsApp Business Cloud API (see ../shared/whatsapp-setup.md) ---
# Leave WHATSAPP_CLOUD_ACCESS_TOKEN empty to leave this channel disabled.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_ALLOWED_USERS=
WHATSAPP_CLOUD_WEBHOOK_PORT=8090

# --- Microsoft Teams (see ../shared/teams-setup.md) ---
# Leave TEAMS_CLIENT_ID empty to leave this channel disabled.
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
TEAMS_ALLOWED_USERS=
TEAMS_PORT=3978

# --- Email (see ../shared/email-setup.md) ---
# Leave EMAIL_ADDRESS empty to leave this channel disabled. Built into
# hermes-agent itself (stdlib smtplib/imaplib, no extra deps) — polls a
# mailbox via IMAP, replies/sends via SMTP.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_ALLOWED_USERS=
EMAIL_POLL_INTERVAL=15

# --- Hermes web dashboard (http://<vps-ip>:9119) ---
# Required: the dashboard refuses to start without these once it's reachable
# from outside 127.0.0.1 (which it is here, via the Docker port mapping).
# Generate a real password with: openssl rand -base64 24
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=changeme-generate-a-real-password

# --- Written automatically by hermes-agent itself ---
# hermes-agent's own wizards (`hermes gateway setup`, etc.) write directly
# to this file — this is the ONLY .env for the whole deployment, see
# ../shared/single-env-file.md. Expect lines like API_SERVER_KEY (an
# auto-generated internal secret) to appear below after first setup —
# don't remove them.
