[Unit]
# Optional: runs the prebuilt llama-server binary as a systemd service,
# instead of the llama-server container in docker-compose.yml.
# See README.md, section "Alternative: native llama.cpp (no Docker)".
#
# Install:
#   cp scripts/llama-server.service.example /etc/systemd/system/llama-server.service
#   # edit the two REPLACE_WITH_REPO_PATH occurrences below, and EnvironmentFile
#   # if your .env lives elsewhere
#   systemctl daemon-reload
#   systemctl enable --now llama-server
Description=llama.cpp server (prebuilt binary)
After=network.target

[Service]
Type=simple
EnvironmentFile=REPLACE_WITH_REPO_PATH/linux-x86_64-vps/.env
WorkingDirectory=REPLACE_WITH_REPO_PATH/linux-x86_64-vps/vendor/llama.cpp-prebuilt/current
ExecStart=REPLACE_WITH_REPO_PATH/linux-x86_64-vps/vendor/llama.cpp-prebuilt/current/llama-server \
  -m REPLACE_WITH_REPO_PATH/linux-x86_64-vps/models/${MODEL_FILE} \
  --host 127.0.0.1 \
  --port 8080 \
  -c ${LLAMA_CTX_SIZE} \
  -t ${LLAMA_THREADS} \
  --jinja
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
