# Copy this to ./data/config.yaml BEFORE the first `docker compose up`
# (./data is the volume mounted at /opt/data in the hermes container — see README.md)
#
# "llama-swap" is the name of the neighboring service in docker-compose.yml;
# Docker Compose's internal network resolves it automatically, no IP or
# host.docker.internal needed here (unlike the macOS version). llama-swap
# routes to whichever model ID is requested — "llama-3.1-8b-instruct" must match
# a key under models: in data/models.yaml exactly (see
# ../../shared/managing-models.md).

model:
  default: llama-3.1-8b-instruct
  provider: custom
  base_url: http://llama-swap:8080/v1
  context_length: 65536

# Hermes auto-detects a local endpoint and raises its stream-stale-timeout
# ceiling to 900s (from a 180s base), but a CPU-only VPS can need longer
# than that just for prompt processing before the first token — see
# "Why the first reply can take a very long time" in
# ../../shared/telegram-setup.md. Without this override, Hermes drops the
# stream at 900s with zero bytes received and retries, 3 times, then gives
# up (visible as "Stream drop on attempt N/3" in the logs).
#
# disabled_toolsets trims tool schemas this bot never uses (measured with
# `hermes prompt-size` — see ../../shared/telegram-setup.md) to shrink the
# per-message prefill on CPU-only hardware. Remove an entry if you actually
# need that toolset (e.g. `vision` for image messages).
agent:
  local_stream_stale_timeout: 3600
  disabled_toolsets:
    - browser-use
    - tts
    - vision

# Every dangerous action requires an explicit human answer — no silent
# auto-approval, on any deployment size. See ../../shared/enterprise-safety.md
# for exactly what this does and does not cover.
approvals:
  mode: manual

# Hermes's default auxiliary-model routing tries free-tier external
# providers (OpenRouter, Nous Portal) before falling back to the main
# model — observed live as "Auxiliary: marking openrouter/nous unhealthy
# (payment / credit error)" outbound calls, each failing since this
# deployment configures neither. Beyond contradicting "nothing leaves the
# server", each failed attempt also contends for this box's scarce CPU
# while the main model is mid-response. Title generation is the only
# auxiliary task Hermes runs unprompted (compression/vision only run when
# actually needed), so disabling it is enough — manual titles still work
# via /title.
auxiliary:
  title_generation:
    enabled: false
