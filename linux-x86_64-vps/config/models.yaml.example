# Copy this to ./data/models.yaml BEFORE the first `docker compose up`
# (see ../../shared/managing-models.md for how to add/remove models — the
# llama-swap container is started with -watch-config, so edits to this file
# take effect immediately, no restart needed).
#
# /app/llama-server is bundled in the ghcr.io/mostlygeek/llama-swap:cpu image
# (verified — see ../../shared/prebuilt-binaries.md). ${env.MODEL_FILE},
# ${env.LLAMA_CTX_SIZE} and ${env.LLAMA_THREADS} come from .env (passed to
# this container via docker-compose.yml's env_file). ${PORT} is llama-swap's
# own macro: a free port it assigns automatically to this model's
# llama-server process.

healthCheckTimeout: 120

models:
  "llama-3.1-8b-instruct":
    name: "Llama 3.1 8B Instruct (default)"
    cmd: |
      /app/llama-server --port ${PORT}
      --model /models/${env.MODEL_FILE}
      --ctx-size ${env.LLAMA_CTX_SIZE}
      --threads ${env.LLAMA_THREADS}
      --jinja
      --flash-attn on
      -ctk q8_0
      -ctv q8_0
      --predict 4096
    ttl: 600
    # -ctk/-ctv q8_0 quantize the KV cache (llama-server default: f16) —
    # cuts llama-server's RSS at this repo's 65536-token context from
    # ~15.8GB to ~12GB on this deployment's CPU build (8 threads),
    # same speed (~6.2-6.6 tok/s either way), tool-calling verified
    # unaffected — confirmed live, issue #52. Same fix already applied
    # on the macOS/Metal path (macos-arm64/config/models.yaml.example),
    # verified separately there.
    #
    # --predict 4096 caps a single completion's generation length
    # (llama-server default: -1, unbounded). Confirmed live, 2026-09-10:
    # an unbounded generation on this VPS pegged llama-server at ~700%
    # CPU for over an hour producing zero usable output, and a client
    # disconnect does NOT cancel it server-side — hermes's own
    # stream-stale watchdog gave up while the "zombie" generation kept
    # running, and the retry queued up behind it. See
    # shared/hardware-sizing.md's 2026-09-10 incident for the full
    # writeup. At this deployment's measured ~7.4 tok/s generation
    # speed, 4096 tokens bounds a single call to ~9 minutes worst case —
    # long enough for a real tool-calling turn, short enough to cap a
    # runaway/repetition-loop generation instead of letting it run
    # unbounded toward the 65536-token context ceiling.
